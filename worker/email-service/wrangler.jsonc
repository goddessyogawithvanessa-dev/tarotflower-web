{
  "name": "tarotflower-web-dev",
  "main": "./index.js",
  "compatibility_date": "2026-07-07",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS"
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://tarotflower.com,https://www.tarotflower.com,https://goddess-yoga-retreats.com,https://www.goddess-yoga-retreats.com,https://tarotflower-web-dev.embodiedgoddesses.workers.dev",
    "CAMPAIGN_FROM": "Vanessa Hylande <vanessa@tarotflower.com>",
    "CAMPAIGN_REPLY_TO": "vanessa@tarotflower.com",
    "CAMPAIGN_OWNER_COPY": "vanessa@tarotflower.com",
    "CAMPAIGN_PUBLIC_ORIGIN": "https://tarotflower.com",
    "CAMPAIGN_BATCH_SIZE": "25",
    "SMTP_AUTHORIZED_FROM": "vanessa@tarotflower.com",
    "CAMPAIGN_AUTHENTICATION_VERIFIED": "true",
    "TAROT_FROM": "Tarot Flower <vanessa@tarotflower.com>",
    "TAROT_REPLY_TO": "vanessa@tarotflower.com",
    "CIRCLE_FROM": "Moonlight Circle <vanessa@tarotflower.com>",
    "CIRCLE_REPLY_TO": "vanessa@tarotflower.com",
    "CONTACT_TURNSTILE_SITE_KEY": "0x4AAAAAADxdJGuO-lzCbR0H",
    "TURNSTILE_ALLOWED_HOSTNAMES": "tarotflower.com,www.tarotflower.com,goddess-yoga-retreats.com,www.goddess-yoga-retreats.com,tarotflower-web-dev.embodiedgoddesses.workers.dev",
    "WORKER_ENV": "dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tarotflower-leads-dev",
      "database_id": "5358b6e4-1411-43e3-bce3-adc7a6fc179f"
    }
  ],
  "r2_buckets": [
    {
      "binding": "GUIDE_ASSETS",
      "bucket_name": "tarotflower-guides-dev"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "secrets": {
    "required": [
      "ADMIN_REVIEW_TOKEN",
      "CAMPAIGN_DEV_SEND_TOKEN",
      "CAMPAIGN_SEND_TOKEN",
      "GUIDE_DOWNLOAD_TOKEN_SECRET",
      "QA_RECORD_TOKEN",
      "SMTP_APP_PASSWORD",
      "SMTP_USERNAME",
      "TURNSTILE_SECRET_KEY"
    ]
  }
}
