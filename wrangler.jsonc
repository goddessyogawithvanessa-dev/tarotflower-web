{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tarotflower-web",
  "main": "./worker/index.js",
  "compatibility_date": "2026-07-18",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "LIBRARY_DB",
      "database_name": "tarotflower-library",
      "database_id": "63c59d36-ead1-473d-a947-3a3ede083e11"
    }
  ],
  "r2_buckets": [
    {
      "binding": "LIBRARY_ASSETS",
      "bucket_name": "tarotflower-digital-rituals"
    }
  ],
  "stream": {
    "binding": "STREAM"
  },
  "services": [
    {
      "binding": "EMAIL_SERVICE",
      "service": "tarotflower-web-dev",
      "entrypoint": "LibraryEmailService"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://tarotflower.com",
    "CIRCLE_ORIGIN": "https://moonlightcircle.com",
    "CIRCLE_DEV_MODE": "false",
    "CIRCLE_OWNER_EMAIL": "goddessyogawithvanessa@gmail.com",
    "WORKBENCH_OWNER_EMAIL": "goddessyogawithvanessa@gmail.com",
    "LIBRARY_TEST_MODE": "false",
    "TURNSTILE_SITE_KEY": "0x4AAAAAADxdJSQWBM1O2yZl",
    "TURNSTILE_EXPECTED_HOSTNAME": "tarotflower.com",
    "CIRCLE_TURNSTILE_SITE_KEY": "0x4AAAAAAFBR5Pn943_RIVYF",
    "FIRE_COMPANION_ASSET_ID": "guide",
    "FIRE_STREAM_CUSTOMER_CODE": "hy95cnv1cg9dflee",
    "FIRE_STREAM_VIDEO_ID": "7906242bfa7407fb68353a05ae2a6739"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "limits": {
    "cpu_ms": 5000
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "routes": [
    {
      "pattern": "tarotflower.com/*",
      "zone_id": "10ce2edc1ceb5f447e251b143cebca1f"
    }
  ]
}
