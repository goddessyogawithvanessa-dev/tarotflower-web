---
const apiBase = 'https://tarotflower-web-dev.embodiedgoddesses.workers.dev';
---
<form class="oracle-waitlist-form tarot-newsletter-form" action={`${apiBase}/api/tarot-newsletter`} method="POST" data-tarot-newsletter>
  <input type="hidden" name="source_path" value={Astro.url.pathname} />
  <input type="text" name="website" tabindex="-1" autocomplete="off" hidden />
  <label><span>Email address</span><input type="email" name="email" autocomplete="email" required /></label>
  <label class="oracle-waitlist-consent"><input type="checkbox" name="consent" value="true" required /><span>I agree to receive Tarot Flower emails. I can unsubscribe at any time.</span></label>
  <div class="contact-turnstile" data-turnstile-widget></div>
  <button type="submit" disabled>Keep Me Posted</button>
  <p class="tarot-newsletter-status" aria-live="polite"></p>
</form>
<script is:inline>
  const newsletterApiBase = 'https://tarotflower-web-dev.embodiedgoddesses.workers.dev';

  const newsletterTurnstileReady = new Promise((resolve) => {
    if (window.turnstile) {
      resolve(window.turnstile);
      return;
    }

    const existingScript = document.querySelector('script[data-turnstile-api]');
    if (existingScript) {
      existingScript.addEventListener('load', () => resolve(window.turnstile), { once: true });
      return;
    }

    const script = document.createElement('script');
    script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
    script.async = true;
    script.defer = true;
    script.dataset.turnstileApi = 'true';
    script.addEventListener('load', () => resolve(window.turnstile), { once: true });
    document.head.append(script);
  });

  async function connectTarotNewsletter(form) {
    if (form.dataset.connected === 'true') return;
    form.dataset.connected = 'true';

    const status = form.querySelector('.tarot-newsletter-status');
    const submit = form.querySelector('button[type="submit"]');
    const container = form.querySelector('[data-turnstile-widget]');
    let widgetId;

    try {
      const response = await fetch(`${newsletterApiBase}/api/contact/config`, {
        headers: { Accept: 'application/json' },
      });
      if (!response.ok) throw new Error('Verification configuration unavailable.');
      const config = await response.json();
      const sitekey = config.turnstileSiteKey || config.siteKey || config.turnstile_site_key;
      if (!sitekey) throw new Error('Verification site key unavailable.');
      const turnstile = await newsletterTurnstileReady;
      widgetId = turnstile.render(container, { sitekey, action: 'newsletter', size: container.clientWidth < 300 ? 'compact' : 'normal' });
    } catch (error) {
      status.textContent = 'Please refresh and try again in a moment.';
      submit.disabled = true;
      return;
    }

    submit.disabled = false;
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      status.textContent = 'Joining...';
      submit.disabled = true;

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const text = await response.text();
        const result = text ? JSON.parse(text) : {};
        if (!response.ok) throw new Error(result.error || 'The signup could not be sent.');
        status.textContent = "Thank you. You're on the list.";
        form.reset();
        window.turnstile.reset(widgetId);
      } catch (error) {
        status.textContent = error.message || 'Please try again in a moment.';
        window.turnstile.reset(widgetId);
      } finally {
        submit.disabled = false;
      }
    });
  }

  document.querySelectorAll('[data-tarot-newsletter]').forEach(connectTarotNewsletter);
</script>
