---
// Each form is its own scroll moment. This component can later host the
// more elaborate transformation without changing the page's structure.
---

<ol class="sacred-cosmology-forms" aria-label="The five cosmological forms of Sacred Becoming">
  <li class="sacred-cosmology-form sacred-cosmology-form--space">
    <img class="sacred-cosmology-symbol" src="/images/sacred-becoming/cosmology-space.webp" alt="Luminous metallic circle" width="1254" height="1254" loading="lazy" decoding="async" />
    <h3>Space</h3>
  </li>
  <li class="sacred-cosmology-form sacred-cosmology-form--embodiment">
    <img class="sacred-cosmology-symbol" src="/images/sacred-becoming/cosmology-embodiment.webp" alt="Luminous metallic pentacle" width="1254" height="1254" loading="lazy" decoding="async" />
    <h3>Embodiment</h3>
  </li>
  <li class="sacred-cosmology-form sacred-cosmology-form--transmutation">
    <img class="sacred-cosmology-symbol" src="/images/sacred-becoming/cosmology-transmutation.webp" alt="Botanical pentacle with a central spiral" width="1254" height="1254" loading="lazy" decoding="async" />
    <h3>Transmutation</h3>
  </li>
  <li class="sacred-cosmology-form sacred-cosmology-form--emergence">
    <img class="sacred-cosmology-symbol" src="/images/sacred-becoming/cosmology-emergence.webp" alt="Pyramid with a living spiral and flower" width="1254" height="1254" loading="lazy" decoding="async" />
    <h3>Emergence</h3>
  </li>
  <li class="sacred-cosmology-form sacred-cosmology-form--union">
    <img class="sacred-cosmology-symbol" src="/images/sacred-becoming/cosmology-divine-union.webp" alt="Singularity with a faint flower" width="1254" height="1254" loading="lazy" decoding="async" />
    <h3>Divine Union</h3>
  </li>
</ol>
