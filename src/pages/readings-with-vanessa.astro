---
import Base from '../layouts/Base.astro';
---

<Base
  title="Readings with Vanessa | Tarot Flower"
  description="Book a live, private, one-on-one online tarot reading with Vanessa. 60 minutes, $100 USD."
  image="/images/readings-with-vanessa/vanessa-shuffling-teal-tarot-cards.png"
  imageAlt="Vanessa smiling while shuffling teal tarot cards"
  imageWidth={947}
  imageHeight={1661}
  showBanner={false}
  additionalSchema={{
    '@type': 'Service',
    '@id': 'https://tarotflower.com/readings-with-vanessa/#service',
    name: '60-minute private online tarot reading with Vanessa Hylande',
    url: 'https://tarotflower.com/readings-with-vanessa/',
    provider: { '@id': 'https://tarotflower.com/#vanessa-hylande' },
    offers: {
      '@type': 'Offer',
      price: '100',
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
      url: 'https://tarotflower.com/checkout/readings-with-vanessa/',
    },
  }}
>
  <main class="reading-sales-page">
    <section class="reading-sales-hero" aria-labelledby="reading-sales-title">
      <div class="reading-sales-hero-image">
        <img
          src="/images/readings-with-vanessa/vanessa-shuffling-teal-tarot-cards.png"
          alt="Vanessa smiling while shuffling teal tarot cards"
          width="947"
          height="1661"
          fetchpriority="high"
        />
      </div>

      <div class="reading-sales-hero-copy">
        <p class="reading-sales-kicker">READINGS WITH VANESSA</p>
        <h1 id="reading-sales-title">What do you want to know?</h1>
        <p>Bring me the question you can't stop thinking about. The decision you keep circling. The relationship you can't quite understand. Or come with no question at all.</p>
        <p class="reading-sales-invitation">You bring your life. I'll bring the cards. Let's see what they have to say.</p>
        <p class="reading-sales-format">60-minute private live online tarot reading · $100 USD</p>
        <a class="reading-sales-button" href="/checkout/readings-with-vanessa/">BOOK YOUR READING</a>
      </div>
    </section>

    <section class="reading-sales-live">
      <div class="reading-sales-live-inner container">
        <h2>LIVE WITH VANESSA</h2>
        <div class="reading-sales-live-copy">
          <p>We’ll meet by video, talk about what’s on your mind, and I’ll pull the cards for you in real time.</p>
          <p>We’ll explore what comes up together and follow the reading wherever it leads.</p>
        </div>
      </div>
    </section>

    <section class="reading-sales-how">
      <div class="reading-sales-how-inner container">
        <div class="reading-sales-how-copy">
          <h2>HOW I READ</h2>
          <p class="reading-sales-how-lede">I don't use tarot to predict the future.</p>
          <p>I read the energetic landscape around you right now—what's opening, what's supporting you, what's standing in your way, and what possibilities are available to you.</p>
          <p>The cards help us see what's moving beneath the surface so you can make informed choices about what comes next.</p>
          <p class="reading-sales-agency">Your future is still yours.</p>
        </div>

        <div class="reading-sales-how-image">
          <img
            src="/images/readings-with-vanessa/vanessa-holding-empress-card.png"
            alt="Vanessa smiling while holding the Empress tarot card"
            width="947"
            height="1661"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <section class="reading-sales-booking" aria-label="Book a private tarot reading with Vanessa">
      <div class="reading-sales-booking-inner container">
        <p class="reading-sales-booking-format">60-minute private live online tarot reading</p>
        <p class="reading-sales-booking-price">$100 USD</p>
        <a class="reading-sales-button" href="/checkout/readings-with-vanessa/">BOOK YOUR READING</a>
      </div>
    </section>
  </main>
</Base>
