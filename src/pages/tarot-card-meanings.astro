---
import Base from '../layouts/Base.astro';

interface Props {
  pageHeading?: string;
  pageTitle?: string;
  introVariant?: 'standard' | 'understanding';
}

const {
  pageHeading = 'Tarot Card Meanings',
  pageTitle = 'Tarot Card Meanings – A Guide to the Major & Minor Arcana',
  introVariant = 'standard',
} = Astro.props;

const isUnderstandingPage = introVariant === 'understanding';

const majorArcana = [
  { name: 'The Fool', slug: 'the-fool-tarot', image: '/images/2023/05/AI-Square.jpg', alt: "The Fool stepping through clouds and peach flowers, Vanessa Hylande’s Tarot Flower artwork of new beginnings" },
  { name: 'The Magician', slug: 'the-magician-tarot', image: '/images/2021/01/magician-2-1.jpg', alt: "Raven before a turquoise moon and flowers, Vanessa Hylande’s Magician Tarot artwork of manifestation at Tarot Flower" },
  { name: 'The High Priestess', slug: 'the-high-priestess-tarot', image: '/images/2021/01/high-priestess-3.jpg', alt: "The High Priestess in purple robes beside an owl, Vanessa Hylande’s Tarot Flower artwork of intuition" },
  { name: 'The Empress', slug: 'the-empress-tarot', image: '/images/2021/01/empress-4.jpg', alt: "The Empress amid blossoms, Vanessa Hylande’s Tarot Flower artwork of nurturing creativity" },
  { name: 'The Emperor', slug: 'the-emperor-tarot', image: '/images/2021/01/the-emperor.jpg', alt: "Golden dragon beneath the stars, Tarot Flower’s Emperor Tarot artwork of authority" },
{ name: 'The Hierophant', slug: 'the-hierophant-tarot', image: '/images/2021/02/hierophant-3.jpg', alt: "Eagle with a golden breastplate above a desert, Vanessa Hylande’s Hierophant artwork of spiritual guidance at Tarot Flower" },
{ name: 'The Lovers', slug: 'the-lovers-tarot', image: '/images/2021/02/lovers.jpg', alt: "Two seahorses facing one another underwater, Vanessa Hylande’s Lovers Tarot artwork of union and choice at Tarot Flower" },
  { name: 'The Chariot', slug: 'the-chariot-tarot', image: '/images/2022/02/chariot-df4.jpg', alt: "Woman riding a white horse beneath the moon, Vanessa Hylande’s Chariot Tarot artwork of will and direction at Tarot Flower" },
{ name: 'Strength', slug: 'strength-tarot', image: '/images/2023/05/strength-white-lady-and-lion-3.jpg', alt: "Woman resting between two white lions among flowers, Vanessa Hylande’s Strength Tarot artwork of gentle courage at Tarot Flower" },
  { name: 'The Hermit', slug: 'the-hermit-tarot', image: '/images/2022/04/hermit-df-3.jpg', alt: "Woman holding a torch beneath the moon, Vanessa Hylande’s Hermit Tarot artwork of inner guidance at Tarot Flower" },
{ name: 'The Wheel of Fortune', slug: 'the-wheel-of-fortune-tarot', image: '/images/2021/01/fates-3.jpg', alt: "Three veiled women with glowing golden spheres, Vanessa Hylande’s Wheel of Fortune artwork of fate and cycles at Tarot Flower" },
  { name: 'Justice', slug: 'justice-tarot', image: '/images/2022/04/Justice-6.jpg', alt: "Lady Justice holding golden scales, Vanessa Hylande’s Tarot Flower artwork of balance and fairness" },
{ name: 'The Hanged Man', slug: 'the-hanged-man-tarot', image: '/images/2023/05/hanged-3.jpg', alt: "Woman beneath a floral crown and golden light, Vanessa Hylande’s Hanged Man artwork of surrender and perspective at Tarot Flower" },
  { name: 'Death', slug: 'death-tarot', image: '/images/2022/02/vanessahylande_a_gorgeous_woman_with_black_hair_with_piercing_b_abeda71f-a1c1-4fba-98c1-d781e0c52686.jpg', alt: "Dark-haired woman among flowers, Vanessa Hylande’s Death Tarot artwork of transformation at Tarot Flower" },
{ name: 'Temperance', slug: 'temperance-tarot', image: '/images/2022/02/vanessahylande_a_beautiful_woman_an_angel_holding_a_cup_of_wate_b8398230-e18c-4296-b105-535ee032aeb3.jpg', alt: "Angel holding two flower-filled cups, Vanessa Hylande’s Temperance Tarot artwork of balance at Tarot Flower" },
{ name: 'The Devil', slug: 'the-devil-tarot', image: '/images/2022/04/devil-9.jpg', alt: "Woman reclining among red roses beneath the stars, Vanessa Hylande’s Devil Tarot artwork of desire and attachment at Tarot Flower" },
  { name: 'The Tower', slug: 'the-tower-tarot', image: '/images/2022/04/tower-4.jpg', alt: "Burning tower beneath storm clouds, Vanessa Hylande’s Tower Tarot artwork of upheaval at Tarot Flower" },
{ name: 'The Star', slug: 'the-star-tarot', image: '/images/2022/02/the-star-df-9.jpg', alt: "Woman with open arms beneath a radiant star, Vanessa Hylande’s Star Tarot artwork of hope and renewal at Tarot Flower" },
  { name: 'The Moon', slug: 'the-moon-tarot', image: '/images/2022/02/owl-8.jpg', alt: "Owl perched among star-lit branches, Vanessa Hylande’s Moon Tarot artwork of intuition at Tarot Flower" },
  { name: 'The Sun', slug: 'the-sun-tarot', image: '/images/2022/02/the-sun-1.jpg', alt: "Woman in golden robes beneath a luminous sun, Tarot Flower’s Sun Tarot artwork of vitality and joy" },
  { name: 'Judgement', slug: 'judgement-tarot', image: '/images/2022/04/jusdg-2.jpg', alt: "Luminous moth among pink flowers and geometric light, Vanessa Hylande’s Judgement Tarot artwork of awakening at Tarot Flower" },
  { name: 'The World', slug: 'the-world-tarot', image: '/images/2022/12/world-10.jpg', alt: "Woman with blossoms before the Earth, Vanessa Hylande’s World Tarot artwork of completion at Tarot Flower" },
];

const suits = [
  {
    name: 'Cups',
    slug: 'cups-tarot',
    image: '/images/2020/12/IMG_20201215_122606-scaled.jpg',
    alt: "White Sage Cups Tarot cards among crystals and shells, Tarot Flower’s guide to emotion and connection",
    element: 'Water, emotions, love, and intuition',
  },
  {
    name: 'Pentacles',
    slug: 'pentacles-tarot',
    image: '/images/2020/12/IMG_20201215_123548-scaled.jpg',
    alt: "White Sage Pentacles Tarot cards among crystals and shells, Tarot Flower’s guide to earth and abundance",
    element: 'Earth, abundance, security, and the physical world',
  },
  {
    name: 'Swords',
    slug: 'swords-tarot',
    image: '/images/2021/01/swords-e1610542966242.jpg',
    alt: "White Sage Swords Tarot cards among crystals and shells, Tarot Flower’s guide to thought and decisions",
    element: 'Air, thought, communication, and decisions',
  },
  {
    name: 'Wands',
    slug: 'wands-tarot',
    image: '/images/2021/01/wands-e1610542935860.jpg',
    alt: "White Sage Wands Tarot cards among crystals and shells, Tarot Flower’s guide to fire and inspiration",
    element: 'Fire, creativity, passion, and inspiration',
  },
];
---

<Base
  title={pageTitle}
  description={isUnderstandingPage
    ? 'Understand how the 78 tarot cards connect through archetype, number, element, symbol, and story across the Major and Minor Arcana.'
    : 'Explore all 78 tarot card meanings with Tarot Flower. Learn the wisdom of the Major and Minor Arcana and deepen your spiritual tarot practice.'}
  image="/images/readings-with-vanessa/tarot-cards-candlelight-smoke.png"
  imageAlt="Tarot cards and candlelight in a dark, atmospheric setting"
  imageWidth={1670}
  imageHeight={941}
  schemaType="CollectionPage"
>
  <main class:list={['container', 'tarot-meanings-page', { 'understanding-tarot-page': isUnderstandingPage }]}>
    <h1>{pageHeading}</h1>

    {isUnderstandingPage ? (
      <section class="tarot-meanings-intro understanding-tarot-intro">
        <div class="understanding-opening">
          <p class="understanding-lede">Seventy-eight cards. A whole universe of archetypes, stories, symbols, and possibility.</p>

          <p>The Tarot isn't simply a collection of 78 separate meanings to memorize. It's a system. The cards speak to one another through archetype, number, element, symbol, and story—and once you begin to understand that structure, the deck becomes much easier to read.</p>

          <p>The Tarot is divided into two great families: the <a href="/major-arcana/">22 cards of the Major Arcana</a> and the <a href="/minor-arcana">56 cards of the Minor Arcana</a>.</p>
        </div>

        <div class="understanding-families">
          <article class="understanding-family">
            <h2>THE MAJOR ARCANA: THE GREAT JOURNEY</h2>
            <p>The Major Arcana holds the great archetypes and thresholds of human experience—the Fool stepping into the unknown, the Lovers choosing, Death transforming, the Tower falling, the World becoming whole.</p>
            <p>Read in sequence, the 22 cards tell a story often called the Fool's Journey: an unfolding path through beginnings, discovery, choice, challenge, transformation, wisdom, and completion.</p>
          </article>

          <article class="understanding-family">
            <h2>THE MINOR ARCANA: LIFE AS WE LIVE IT</h2>
            <p>The Minor Arcana brings that great journey down into everyday life. Its four suits move through the elements:</p>
            <ul class="understanding-elements">
              <li><a href="/cups-tarot">Cups</a> · Water — emotion, love, intuition, connection</li>
              <li><a href="/pentacles-tarot">Pentacles</a> · Earth — body, abundance, security, the material world</li>
              <li><a href="/swords-tarot">Swords</a> · Air — mind, thought, communication, decisions</li>
              <li><a href="/wands-tarot">Wands</a> · Fire — creativity, passion, inspiration, action</li>
            </ul>
          </article>
        </div>

        <div class="understanding-pattern">
          <h2>THERE'S A PATTERN INSIDE EVERY SUIT.</h2>
          <p>Each suit moves from Ace through Ten, then into the Page, Knight, Queen, and King. So instead of memorizing 56 unrelated Minor Arcana cards, you can begin to recognize the underlying language: the number tells you something about where you are in the story; the suit tells you what realm of life that story is moving through.</p>
        </div>

        <div class="understanding-closing">
          <p>Together, the 78 cards become a language for exploring what is moving through your life, what you may not yet see, and what might be asking for your attention.</p>
          <p class="tarot-meanings-invitation">Pick a card. Follow your curiosity. See what it has to show you.</p>
        </div>
      </section>
    ) : (
      <section class="tarot-meanings-intro">
        <p>Seventy-eight cards. A whole universe of archetypes, stories, symbols, and possibility. The Tarot is divided into two great families: the <a href="/major-arcana/">22 cards of the Major Arcana</a> and the <a href="/minor-arcana">56 cards of the Minor Arcana</a>. The Major Arcana holds the great archetypes of the human journey—the Fool stepping into the unknown, the Lovers choosing, Death transforming, the Tower falling, the World becoming whole.</p>

        <p>The Minor Arcana brings the story down into the texture of everyday life. Its four suits move through the elements: <a href="/cups-tarot">Cups</a> · Water · Emotion, <a href="/pentacles-tarot">Pentacles</a> · Earth · The material world, <a href="/swords-tarot">Swords</a> · Air · Mind and thought, and <a href="/wands-tarot">Wands</a> · Fire · Creativity and action. Each suit travels from Ace through Ten and into the Court Cards—Page, Knight, Queen, and King—creating its own unfolding story.</p>

        <p>Together, the 78 cards become a language for exploring what is moving through your life, what you may not yet see, and what might be asking for your attention. <span class="tarot-meanings-invitation">Pick a card. Follow your curiosity. See what it has to show you.</span></p>
      </section>
    )}

    <section class="tarot-meanings-section" aria-labelledby="major-arcana-heading">
      <header class="tarot-meanings-section-heading">
        <h2 id="major-arcana-heading">The Major Arcana</h2>
        <p>The Great Archetypes of the Tarot</p>
      </header>

      <div class="zodiac-grid tarot-major-grid">
        {majorArcana.map(card => (
          <a href={`/${card.slug}`} class="zodiac-card">
            <div class="zodiac-img">
              <img src={card.image} alt={card.alt} loading="lazy" />
            </div>
            <div class="zodiac-info">
              <h3>{card.name}</h3>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="tarot-meanings-section tarot-minor-section" aria-labelledby="minor-arcana-heading">
      <header class="tarot-meanings-section-heading">
        <h2 id="minor-arcana-heading">The Minor Arcana</h2>
        <p>The Four Suits of the Tarot</p>
      </header>

      <div class="tarot-suits-grid">
        {suits.map(suit => (
          <a href={`/${suit.slug}`} class="zodiac-card tarot-suit-card">
            <div class="zodiac-img tarot-suit-image">
              <img src={suit.image} alt={suit.alt} loading="lazy" />
            </div>
            <div class="zodiac-info">
              <h3>{suit.name}</h3>
              <p>{suit.element}</p>
              <span>Explore {suit.name}</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
</Base>
