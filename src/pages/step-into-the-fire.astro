---
import Base from '../layouts/Base.astro';

const productURL = 'https://buy.stripe.com/fZu5kDcBq2SDaoTftZcbC01';
const imageBase = '/images/digital-rituals/step-into-the-fire';
---
<Base
  title="Step Into the Fire | Tarot Flower"
  description="A guided digital fire ritual with candle ceremony, journaling, embodied movement, original music, sound bath meditation, and permanent access."
  image={`${imageBase}/elemental-rituals-header.jpg`}
  showBanner={false}
>
  <main class="digital-ritual-page">
    <div
      class="digital-ritual-banner"
      role="img"
      aria-label="Fire goddess beneath a golden moon, surrounded by flames and flowers"
      style={`background-image: url('${imageBase}/elemental-rituals-header.jpg')`}
    ></div>

    <section class="digital-ritual-introduction">
      <div class="digital-ritual-row">
        <h1>Step Into the Fire</h1>
        <h2>A digital ritual for courage &amp; confidence</h2>
        <a class="digital-ritual-button" href={productURL}>Ignite</a>
      </div>
      <div class="digital-ritual-row digital-ritual-opening">
        <p>
          This ritual is a sacred initiation into your own inner fire. Through candlelight, intention, movement, music, meditation, and the ancient element of fire, you’ll release what no longer serves you, reclaim your inner strength, and awaken the guardian within.<br />
          <strong>This is your moment to rise, radiant and unapologetic.</strong>
        </p>
      </div>
    </section>

    <section class="digital-ritual-content">
      <div class="digital-ritual-row">
        <p class="digital-ritual-ornament" aria-hidden="true">☽⋆˚｡𖤓｡˚⋆☾</p>
      </div>

      <div class="digital-ritual-row digital-ritual-columns">
        <div class="digital-ritual-column">
          <img
            src={`${imageBase}/fire-goddess-front-flipped.jpg`}
            width="1050"
            height="1500"
            alt="Fire goddess artwork with red hair, floral crown, and flames — symbolic digital illustration for courage, confidence, and feminine empowerment rituals. AI artwork by Vanessa Hylande"
            title="fire goddess front flipped"
          />
          <div class="digital-ritual-copy">
            <h2>What’s Included</h2>
            <p>
              • Hosted Digital Ritual Experience<br />
              • Four Guided Ritual Videos<br />
              • Downloadable Ritual Guide (PDF)<br />
              • Original Music Download (MP3)<br />
              • Permanent Access
            </p>
            <p><em>Self-paced • Permanent access • Designed to be revisited whenever you need to reconnect with your inner fire</em></p>
            <p class="digital-ritual-symbols" aria-hidden="true">☽⋆˚｡𖤓｡˚⋆☾</p>
          </div>
        </div>

        <div class="digital-ritual-column">
          <img
            src={`${imageBase}/burn-oracle-card-crisp.png`}
            width="525"
            height="750"
            alt="Burn oracle card with floral fire and cosmic background — symbolizing purification, transformation, and creative rebirth in divine feminine rituals. AI art by Vanessa Hylande"
            title="Burn Oracle back"
          />
          <div class="digital-ritual-copy">
            <h2>Who It’s For</h2>
            <p>
              ☽ Women craving a spark of confidence and action<br />
              ☽ Creatives ready to ignite a new project or direction<br />
              ☽ Seekers shedding self-doubt and stepping into power<br />
              ☽ Anyone feeling stuck, heavy, or disconnected from purpose<br />
              ☽ Women standing at a threshold of change<br />
              ☽ Those ready to reclaim their authentic voice and trust their inner guidance<br />
              ☽ Anyone longing for a meaningful ritual they can return to
            </p>
            <p class="digital-ritual-symbols" aria-hidden="true">☽⋆˚｡𖤓｡˚⋆☾</p>
          </div>
        </div>
      </div>

      <div class="digital-ritual-row">
        <div class="digital-ritual-copy">
          <h2>Your Journey</h2>
          <p>
            <strong>Initiation — I Choose</strong><br />
            Enter the ritual, light your candle, and make a conscious commitment to yourself.
          </p>
          <p>
            <strong>Destruction — I Release</strong><br />
            Name what you are ready to leave behind and offer it to the transforming fire.
          </p>
          <p>
            <strong>Guardian — I Embody</strong><br />
            Raise your energy through movement, original music, and embodied strength.
          </p>
          <p>
            <strong>Freedom — I Receive</strong><br />
            Lie down for the sound bath meditation, surrender, listen, and receive.
          </p>
          <p>
            <strong>Closing Blessing</strong><br />
            Integrate the journey and carry the fire forward with you.
          </p>
        </div>
      </div>

      <div class="digital-ritual-row">
        <div class="digital-ritual-audio">
          <div
            class="digital-ritual-audio-cover"
            role="img"
            aria-label="Warrior Goddess album artwork"
            style={`background-image: url('${imageBase}/fire-goddess-music.jpeg')`}
          ></div>
          <div class="digital-ritual-audio-content">
            <h2>Warrior Goddess</h2>
            <p>by <strong>Vanessa Hylande</strong></p>
            <p>This original song accompanies the Guardian embodiment practice and is included as a full MP3 download.</p>
            <audio controls preload="none">
              <source src="/audio/digital-rituals/warrior-goddess-snippet.mp3" type="audio/mpeg" />
              <a href="/audio/digital-rituals/warrior-goddess-snippet.mp3">Listen to Warrior Goddess</a>
            </audio>
          </div>
        </div>
      </div>

      <div class="digital-ritual-row digital-ritual-closing">
        <h2><strong>Leave the ashes behind.<br />Rise up and shine.</strong></h2>
        <p>Begin your ritual today and let the fire guide you.</p>
        <p class="digital-ritual-price">
          <strong>$33 USD</strong><br />
          One-time purchase • Permanent access
        </p>
        <a class="digital-ritual-button" href={productURL}>Ignite</a>
      </div>
    </section>
  </main>
</Base>

<style>
  .digital-ritual-price {
    color: #2b2b2b;
    line-height: 1.55;
  }

  .digital-ritual-price strong {
    color: #000;
    font-family: 'Aboreto', serif;
    font-size: 28px;
    font-weight: 500;
  }
</style>
