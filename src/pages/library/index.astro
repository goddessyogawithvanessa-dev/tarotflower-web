---
import Base from '../../layouts/Base.astro';
---

<Base
  title="My Ritual Library | Tarot Flower"
  description="Return to the Digital Rituals you own and access your private guides, music, and movement practices."
>
  <main class="library-page">
    <header class="readings-hero container library-header">
      <div>
        <h1>My Ritual Library</h1>
        <p>A private home for every ritual you own.</p>
      </div>
      <button class="library-logout" type="button" data-library-logout>Sign Out</button>
    </header>

    <section class="library-shell container" data-library-shell>
      <p class="library-loading" data-library-loading>Opening your library…</p>
      <div class="library-grid" hidden data-library-grid></div>
      <div class="library-empty" hidden data-library-empty>
        <h2>Your library is ready for its first ritual.</h2>
        <p>When a Digital Ritual is purchased with this email, it will appear here permanently.</p>
        <a class="shop-button" href="/shop/">Explore the Shop</a>
      </div>
    </section>
  </main>

  <script src="/scripts/library.js" is:inline></script>
</Base>
