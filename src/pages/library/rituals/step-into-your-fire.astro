---
import RitualExperience from '../../../layouts/RitualExperience.astro';
import { ritualExperiences } from '../../../data/ritualExperiences';

const fireRitual = ritualExperiences.fire;
---

<RitualExperience
  title="Step Into Your Fire | My Library"
  description="A private ceremonial journey within your Tarot Flower library."
  image={fireRitual.image}
>
  <header class="fire-private-nav">
    <a class="fire-private-wordmark" href="/" aria-label="Tarot Flower public homepage">Tarot Flower</a>
    <nav aria-label="Private ritual navigation">
      <a href="/library/">My Library</a>
    </nav>
  </header>
  <main class="fire-ritual-experience digital-ritual-page--fire" data-ritual-experience data-product-slug="step-into-your-fire">
    <div class="fire-ritual-loading" data-ritual-loading>
      <span class="fire-ritual-ember" aria-hidden="true"></span>
      <p>Opening the ritual…</p>
    </div>

    <article class="fire-ritual-page fire-ritual-gateway" data-ritual-content hidden>
      <header class="fire-ritual-opening fire-gateway-opening">
        <img
          class="fire-ritual-opening-image"
          src={fireRitual.image}
          width={fireRitual.width}
          height={fireRitual.height}
          alt={fireRitual.imageAlt}
        />
        <div class="fire-ritual-opening-shade" aria-hidden="true"></div>
        <div class="fire-ritual-opening-copy fire-gateway-opening-copy">
          <p class="fire-ritual-eyebrow">YOUR PRIVATE RITUAL</p>
          <h1>Step Into Your Fire</h1>
          <p class="fire-gateway-welcome">Welcome, Warrior Goddess.</p>
          <p class="fire-gateway-guidance"><strong>Before you begin, please take a moment to read your Ritual Companion.</strong> It explains the meaning of the ritual, what you'll need, and how to prepare your sacred space.</p>
        </div>
      </header>

      <section class="fire-ritual-section fire-companion fire-gateway-companion" aria-labelledby="companion-title">
        <div class="fire-ritual-row fire-companion-composition">
          <p class="fire-ritual-eyebrow">YOUR 16-PAGE RITUAL GUIDE</p>
          <h2 id="companion-title">Your Ritual Companion</h2>
          <div class="fire-companion-actions" aria-label="Ritual companion options">
            <a class="fire-download-link fire-download-link--primary" href="/api/library/files/step-into-your-fire/guide" target="_blank" rel="noopener">OPEN / READ</a>
            <a class="fire-download-link" href="/api/library/files/step-into-your-fire/guide?download=1">DOWNLOAD PDF</a>
            <button class="fire-download-link" type="button" data-print-companion data-companion-url="/api/library/files/step-into-your-fire/guide">PRINT COMPANION</button>
          </div>
        </div>
      </section>

      <section class="fire-ritual-section fire-ritual-begin" aria-labelledby="let-us-begin-title">
        <div class="fire-threshold-glow" aria-hidden="true"></div>
        <div class="fire-ritual-row fire-begin-copy">
          <h2 id="let-us-begin-title">Let's Begin</h2>
          <p>When you're ready, press Play.</p>
        </div>
        <div class="fire-ritual-wide-row fire-begin-player-wrap">
          <div id="complete-ritual-video" class="fire-unified-video-placeholder" data-unified-video-target aria-live="polite">
            <div class="fire-video-loading" data-video-loading>
              <span class="fire-video-play-mark" aria-hidden="true"></span>
              <p>STEP INTO YOUR FIRE</p>
              <small>PREPARING YOUR COMPLETE RITUAL</small>
            </div>
            <p class="fire-video-error" data-video-error hidden>The ritual video could not be opened. Please refresh the page or return through My Library.</p>
          </div>
        </div>
      </section>

      <section class="fire-ritual-section fire-continuation" aria-labelledby="continuation-title">
        <div class="fire-ritual-row">
          <h2 id="continuation-title">CONTINUE THE SACRED BECOMING</h2>
          <nav class="fire-continuation-links" aria-label="Continue the Sacred Becoming">
            <a href="/sacred-becoming/oracle-deck/">Sacred Becoming Oracle Deck</a>
            <a href="/rituals/"><strong>Elemental Rituals</strong><span>Fire · Water · Earth · Air · Aether</span></a>
            <a href="/sacred-becoming/mentorship/">Sacred Becoming Mentorship</a>
            <a href="https://goddess-yoga-retreats.com/retreats/">Goddess Yoga Retreats</a>
            <a href="/readings-with-vanessa/">Tarot Readings</a>
            <a href="/goddess-embodiment-practices/">Vanessa Hylande</a>
          </nav>
          <a class="fire-return-library" href="/library/">Return to My Library</a>
        </div>
      </section>
    </article>

    <section class="fire-ritual-access-error" hidden data-ritual-error>
      <p class="fire-ritual-eyebrow">PRIVATE RITUAL</p>
      <h1>This ritual isn’t available in the current library session.</h1>
      <a class="digital-ritual-button" href="/library/login/">Sign In to My Library</a>
    </section>
  </main>

  <script src="/scripts/fire-ritual-page.js" is:inline></script>
</RitualExperience>
