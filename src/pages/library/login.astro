---
import Base from '../../layouts/Base.astro';
---

<Base
  title="My Ritual Library Login | Tarot Flower"
  description="Receive a secure passwordless link to access your permanent Tarot Flower ritual library."
>
  <main class="library-page library-login-page">
    <header class="readings-hero container">
      <h1>My Ritual Library</h1>
      <p>Your rituals are always here when you are ready to return.</p>
    </header>

    <section class="library-login-card container" aria-labelledby="library-login-title">
      <p class="library-kicker">Passwordless access</p>
      <h2 id="library-login-title">Send Me a Secure Link</h2>
      <p>Enter the email address you used at checkout. We’ll send you a private, single-use link to your library.</p>

      <form class="library-login-form" data-library-login-form>
        <label for="library-email">Purchase email</label>
        <input id="library-email" type="email" name="email" autocomplete="email" required />
        <div class="library-turnstile" data-library-turnstile></div>
        <button class="shop-button" type="submit">Email My Magic Link</button>
        <p class="library-form-status" aria-live="polite" data-library-status></p>
        <a class="library-debug-link" href="#" hidden data-library-debug-link>Open the local test magic link</a>
      </form>

      <p class="library-privacy-note">For your privacy, this page never confirms whether an email address has a purchase.</p>
    </section>
  </main>

  <script src="/scripts/library-login.js" is:inline></script>
</Base>
