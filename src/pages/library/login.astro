---
import Base from '../../layouts/Base.astro';
import LibraryHeader from '../../components/LibraryHeader.astro';
---

<Base
  title="My Library Login | Tarot Flower"
  description="Sign in with your email and password to access your permanent Tarot Flower library."
  showBanner={false}
  showNavigation={false}
  showFooter={false}
  enableMarketingTracking={false}
  noindex={true}
>
  <main class="library-page library-login-page">
    <LibraryHeader />
    <section class="library-doorway" aria-labelledby="library-login-title">
      <div class="library-doorway-ornament" aria-hidden="true"><span></span></div>
      <div class="library-login-card">
        <p class="library-kicker">My Library</p>
        <h1 id="library-login-title">Welcome to My Library.</h1>
        <div class="library-gold-mark" aria-hidden="true"></div>
        <p class="library-login-intro"><strong>Already have an account?</strong><br />Sign in with your email and password.</p>

        <form class="library-login-form" data-library-login-form>
          <label for="library-email">Email address</label>
          <input id="library-email" type="email" name="email" autocomplete="email" placeholder="Your email address" required />
          <label for="library-password">Password</label>
          <input id="library-password" type="password" name="password" autocomplete="current-password" placeholder="Your password" maxlength="128" required />
          <div class="library-turnstile" data-library-turnstile></div>
          <button class="library-primary-button" type="submit">Sign In <span aria-hidden="true">→</span></button>
          <p class="library-form-status" aria-live="polite" data-library-status></p>
          <div class="library-account-links">
            <a href="/library/forgot/">Forgot Password?</a>
          </div>
        </form>

        <div class="library-new-account">
          <p><strong>New here?</strong></p>
          <a class="library-secondary-button" href="/library/setup/">Create your account</a>
        </div>

        <p class="library-privacy-note">Your purchases remain safely connected to your checkout email.</p>
      </div>
    </section>
    <footer class="library-private-footer"><span>Tarot Flower</span><small>Your private sacred space</small></footer>
  </main>

  <script src="/scripts/library-login.js" is:inline></script>
</Base>
