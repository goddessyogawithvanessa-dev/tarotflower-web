---
import Base from '../layouts/Base.astro';
import OracleWaitlist from '../components/OracleWaitlist.astro';
import { ritualExperienceList, ritualExperiences } from '../data/ritualExperiences';

const fireRitual = ritualExperiences.fire;
const comingSoonRituals = ritualExperienceList.filter(ritual => ritual.key !== 'fire');
---
<Base
  title="Shop | Tarot Flower"
  description="Explore Tarot Flower offerings for reflection, embodiment, ritual, intuitive guidance, and becoming."
>
  <main class="shop-landing">
    <header class="shop-hero container">
      <h1>Shop</h1>
      <p class="shop-hero-question">What are you drawn to today?</p>
    </header>

    <div class="shop-sections container">
      <section class="shop-section shop-rituals-section" aria-labelledby="shop-rituals-title">
        <header class="shop-section-heading">
          <h2 id="shop-rituals-title">Rituals</h2>
        </header>

        <article class="shop-ritual-featured">
          <a class="shop-ritual-featured-image" href={fireRitual.href}>
            <img
              src={fireRitual.image}
              alt={fireRitual.imageAlt}
              width={fireRitual.width}
              height={fireRitual.height}
            />
          </a>
          <div class="shop-ritual-featured-copy">
            <p class="shop-product-label">{fireRitual.availability}</p>
            <h3><a href={fireRitual.href}>{fireRitual.title}</a></h3>
            <p class="shop-product-themes">{fireRitual.themes}</p>
            {fireRitual.purchasable && <p class="shop-price">{fireRitual.priceLabel}</p>}
            <a class="shop-button" href={fireRitual.href}>View Ritual</a>
          </div>
        </article>

        <div class="shop-coming-ritual-grid">
          {comingSoonRituals.map(ritual => (
            <article class={`shop-coming-ritual shop-coming-ritual--${ritual.key}`}>
              <div class="shop-coming-ritual-image">
                <img
                  src={ritual.image}
                  alt={ritual.imageAlt}
                  width={ritual.width}
                  height={ritual.height}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="shop-coming-ritual-copy">
                <h3>{ritual.title}</h3>
                <p>{ritual.themes}</p>
                <span>{ritual.availability}</span>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="shop-section" aria-labelledby="shop-guidance-title">
        <header class="shop-section-heading">
          <h2 id="shop-guidance-title">Personal Guidance</h2>
        </header>

        <div class="shop-guidance-grid">
          <article class="shop-guidance-card">
            <div class="shop-guidance-image shop-guidance-image--reading">
              <img
                src="/images/readings-with-vanessa/vanessa-holding-empress-card.png"
                alt="Vanessa smiling while holding the Empress tarot card"
                loading="lazy"
              />
            </div>
            <div class="shop-guidance-copy">
              <h3>Readings with Vanessa</h3>
              <p>A personal one-on-one tarot reading designed around your questions, your life, and the moment you are navigating.</p>
              <p class="shop-format">60-minute online reading</p>
              <p class="shop-price">$100 USD</p>
              <a class="shop-button" href="/checkout/readings-with-vanessa/">Book a Reading</a>
            </div>
          </article>

          <article class="shop-guidance-card">
            <div class="shop-guidance-image shop-guidance-image--mentorship">
              <img
                src="/images/sacred-becoming/walking-beside-you.jpg"
                alt="Vanessa Hylande wearing red and looking directly at the camera"
                loading="lazy"
              />
            </div>
            <div class="shop-guidance-copy">
              <h3>Sacred Becoming Mentorship</h3>
              <p>A deeply personal one-on-one mentoring journey combining embodiment, reflection, movement, ritual, tarot, and intuitive guidance.</p>
              <a class="shop-button" href="/sacred-becoming/mentorship/">Discover the Mentorship</a>
            </div>
          </article>
        </div>
      </section>

      <section class="shop-section" aria-labelledby="shop-coming-soon-title">
        <header class="shop-section-heading">
          <h2 id="shop-coming-soon-title">Coming Soon</h2>
        </header>

        <article class="shop-oracle">
          <a class="shop-oracle-art" href="/sacred-becoming/oracle-deck/" aria-label="The Sacred Becoming Oracle Deck">
            <img
              src="/images/homepage/07_creation.png.png"
              alt="Creation card artwork from The Sacred Becoming Oracle"
              loading="lazy"
            />
          </a>
          <div class="shop-oracle-copy">
            <p class="shop-product-label">Coming Soon</p>
            <h3><a href="/sacred-becoming/oracle-deck/">Sacred Becoming Oracle</a></h3>
            <p>I created this oracle deck while walking my own path of becoming. It was my companion. Now, I’m bringing it to life as a 36-card deck to accompany you on your own journey.</p>
            <p>Every card is a mirror. Who are you becoming?</p>
            <OracleWaitlist />
          </div>
        </article>
      </section>
    </div>
  </main>
</Base>
